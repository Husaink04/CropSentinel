# Python
__pycache__/
.pytest_cache/
*.py[cod]
.venv/
venv/
.env
.env.*
!.env.example

# Coverage
.coverage
.coverage.*
htmlcov/
coverage.xml

# Node
frontend/node_modules/
frontend/dist/
frontend/vite.config.js.timestamp-*.mjs
*.log

# Playwright
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
frontend/.playwright/

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/

# Local DB / secrets (never commit)
backend/croppro.db
*.pem
# …but DO commit the public license key — it ships with CropSentinel
!backend/licensing/public_key.pem

# Licensing: never commit vendor private key or customer licenses
secrets/
licenses/
license.key

# Generated reports (optional — remove if you want reports in repo)
backend/reports/*.pdf

# Agent installer build artifacts (large binaries, rebuilt per release)
installer/dist/
installer/build/
installer/config.env
installer/cropsentinel-agent-*.exe

# Prebuilt installers served by the portal — keep folder (.gitkeep + README),
# drop the binary artifacts themselves.
backend/dist/installers/*.zip
backend/dist/installers/*.exe

# Large media / demo assets — keep out of git history
*.mp4
*.mov
*.avi

# Editor / process temp files
*.tmp.*
agent/agent.py.tmp.*
*~
*.swp

# Accidental brace-named workspace folder
{backend,agent,frontend/

# Frontend build output served by the backend — regenerated by `npm run build`
backend/static/assets/

backend/dist/installers/*.msi
