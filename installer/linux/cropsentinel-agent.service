[Unit]
Description=CropSentinel Linux Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__INSTALL_DIR__/app
EnvironmentFile=__CONFIG_FILE__
ExecStart=__INSTALL_DIR__/.venv/bin/python "__INSTALL_DIR__/app/linux agent.py"
Restart=always
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
