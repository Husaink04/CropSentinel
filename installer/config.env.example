# CropSentinel agent installer configuration
#
# Copy this file to config.env if you are testing the installer manually.
# The EXE installer copies config.env into C:\ProgramData\CropSentinel\config.env.

# Public server URL the agent should connect to
CROPSENTINEL_SERVER=http://localhost:8000
CROPPRO_SERVER=http://localhost:8000

# Per-tenant enrollment token generated by the portal
CROPSENTINEL_ENROLL_TOKEN=cpet_your_token_here
CROPPRO_ENROLL_TOKEN=cpet_your_token_here

# Optional agent API key if your deployment requires it
CROPSENTINEL_AGENT_KEY=
CROPPRO_AGENT_KEY=

# Optional local stop-password hash for offline admin stop/uninstall checks.
# Prefer bcrypt hashes. Example:
# python -c "import bcrypt; print(bcrypt.hashpw(b'YourPassword', bcrypt.gensalt()).decode())"
AGENT_STOP_PASSWORD_HASH=
CROPSENTINEL_STOP_PASSWORD_HASH=

# Optional tuning values
CROPSENTINEL_SCREENSHOT_INTERVAL=60
CROPPRO_SCREENSHOT_INTERVAL=60
CROPSENTINEL_SYNC_INTERVAL=30
CROPPRO_SYNC_INTERVAL=30
