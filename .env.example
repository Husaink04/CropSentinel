# ============================================================================
# CropSentinel — Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env to version control.
# ============================================================================

# ── Backend ──────────────────────────────────────────────────────────────────

# JWT signing key — REQUIRED. Use a long random string (48+ chars).
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/cropsentinel

# Postgres password (used by docker-compose for the db service)
POSTGRES_PASSWORD=YOUR_PASSWORD

# Default admin credentials (used ONLY on first-run database seed)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=Admin@CropSentinel2024
DEFAULT_AGENT_STOP_PASSWORD=StopAgent@CropSentinel

# CORS allowed origins (comma-separated). Use * for development only.
CORS_ORIGINS=http://localhost:5173

# Shared secret for agent authentication (HTTP + WebSocket).
# Leave empty to disable agent key checks (development only).
AGENT_API_KEY=

# Redis URL for multi-instance WebSocket pub/sub.
# Recommended for production so multi-worker and multi-instance delivery stays consistent.
# Local Docker Compose defaults this to redis://redis:6379/0.
# Format: redis://[:password@]host:port/db  or  rediss://... for TLS
REDIS_URL=

# Next-gen internal event backbone.
# Start with `noop` to keep current behavior. Set to `kafka` or `redis` when the event bus is provisioned.
EVENT_BUS_BACKEND=noop
EVENT_BUS_CONSUME_EXTERNAL=0
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Internal service auth for future service extraction and internal health routes.
INTERNAL_SERVICE_TOKEN=
PROMETHEUS_METRICS_TOKEN=

# Hybrid-ready object storage abstraction.
# `filesystem` keeps current local behavior. Use `s3` for MinIO / S3-compatible storage.
OBJECT_STORAGE_BACKEND=filesystem
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=cropsentinel-evidence
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_REGION=us-east-1

# Analytical database target for future activity/query offload.
CLICKHOUSE_URL=http://localhost:8123
ANALYTICS_BACKEND=noop
CLICKHOUSE_ANALYTICS_READS=0
CLICKHOUSE_ANALYTICS_FLUSH_BATCH=250
CLICKHOUSE_ANALYTICS_FLUSH_INTERVAL_SECONDS=2.0

# Operational telemetry and log shape.
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE_PATH=

# Backup and disaster-recovery controls.
BACKUP_STATUS_FILE=
BACKUP_RETENTION_DAYS=14
BACKUP_POSTGRES_ENABLED=1
BACKUP_REDIS_ENABLED=1
BACKUP_OBJECT_STORAGE_ENABLED=1
BACKUP_CLICKHOUSE_ENABLED=1
DR_TARGET_RTO_MINUTES=30
DR_TARGET_RPO_MINUTES=5
DR_CROSS_REGION_ENABLED=0

# Backend API worker count. Start with 3 for ~200-machine production rollouts.
BACKEND_WORKERS=3
AGENT_CONTROL_WORKERS=2
MONITORING_WORKERS=2
REALTIME_WORKERS=2

# PostgreSQL pool per backend process.
# Keep total connections across all workers within your Postgres max_connections budget.
DB_POOL_MIN=2
DB_POOL_MAX=20

# Sentry error monitoring for the backend API.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Agent ────────────────────────────────────────────────────────────────────

# Server URL the agent connects to
CROPSENTINEL_SERVER=http://localhost:8000
CROPPRO_SERVER=http://localhost:8000

# Agent API key — must match AGENT_API_KEY above when enforced
CROPSENTINEL_AGENT_KEY=
CROPPRO_AGENT_KEY=

# SHA-256 hash of agent stop password (offline verification fallback)
AGENT_STOP_PASSWORD_HASH=

# Screenshot capture interval in seconds.
# For fleet rollouts keep this conservative unless screenshots are truly required.
CROPSENTINEL_SCREENSHOT_INTERVAL=180
CROPPRO_SCREENSHOT_INTERVAL=180

# Activity sync interval in seconds (default: 30)
CROPSENTINEL_SYNC_INTERVAL=30
CROPPRO_SYNC_INTERVAL=30

# Fleet-safe defaults pushed from the backend to agents on first rollout.
# These are used when tenant settings do not already exist.
DEFAULT_TRACK_SCREENSHOTS=0
DEFAULT_TRACK_BROWSER=1
DEFAULT_TRACK_APPLICATIONS=1
DEFAULT_TRACK_INPUT_ACTIVITY=0
DEFAULT_SCREENSHOT_INTERVAL=180
DEFAULT_ACTIVITY_SYNC_INTERVAL=30
DEFAULT_INPUT_BUCKET_SECONDS=30

# Baseline inventory is expensive at fleet scale. Keep it off by default,
# then enable it gradually per tenant after load validation.
DEFAULT_BASELINE_INVENTORY_ENABLED=0
DEFAULT_BASELINE_INVENTORY_WORKER_COUNT=1
DEFAULT_BASELINE_INVENTORY_IO_THROTTLE_SECONDS=0.05
DEFAULT_BASELINE_INVENTORY_UPLOAD_INTERVAL_SECONDS=60
DEFAULT_BASELINE_INVENTORY_UPLOAD_BATCH_SIZE=100
DEFAULT_BASELINE_INVENTORY_MAX_HASH_FILE_SIZE=0
DEFAULT_BASELINE_INVENTORY_MAX_PARSER_FILE_SIZE=26214400
DEFAULT_BASELINE_INVENTORY_MAX_OCR_FILE_SIZE=10485760
DEFAULT_BASELINE_INVENTORY_RESCAN_UNCHANGED_AFTER_SECONDS=86400
DEFAULT_BASELINE_INVENTORY_MOUNT_DISCOVERY_INTERVAL_SECONDS=300

# ── WebRTC (Optional) ───────────────────────────────────────────────────────

# TURN server for NAT traversal (required for remote access behind strict NAT)
WEBRTC_TURN_URL=
WEBRTC_TURN_USER=
WEBRTC_TURN_PASS=

# Screen capture FPS for WebRTC streaming (default: 10)
WEBRTC_FPS=10

# Frontend Sentry configuration (Vite).
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
